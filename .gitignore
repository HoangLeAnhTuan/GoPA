# ==========================================
# GoPA Root — Git Ignore Specification
# ==========================================

# Temporary & Cache Directories (Crucial: prevents build/mod cache floods)
.tmp/
tmp/
.temp/
temp/
.cache/
*.cache

# Compiled Binaries & Go Executables
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
bin/
be/bin/
be/api
be/api.exe
be/worker
be/worker.exe
be/migrate
be/migrate.exe

# Go Module Vendor (if used locally)
vendor/

# Test & Coverage Outputs
*.out
coverage.out
coverage.html
coverage.txt
profile.out
*.prof
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Node & Frontend Build Artifacts
node_modules/
dist/
dist-ssr/
.vite/
.turbo/
.eslintcache
*.tsbuildinfo

# Python Cache & Build Artifacts
__pycache__/
*.py[cod]
*$py.class
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
env/

# Logs & Debug Output
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Variables & Secrets (Keep example files)
.env
.env.*
.env.local
!.env.example

# Local Database Dumps & Test Storage
data/
*.db
*.sqlite
*.sqlite3

# Claude Code Agent Files
# Keep: .agents/rules/ and .agents/personas/ (project-specific AI config)
# Ignore: bundled skills and references (managed by Claude Code, not the project)
.agents/skills/
.agents/references/

# Claude Code runtime & session files
.claude/

# Claude Code skill manager lock file (internal tooling, not a project artifact)
skills-lock.json

# AI agent operational guides (internal development tooling, not user-facing docs)
# Keep: MASTER_PROMPT.md, README.md, CHANGELOG.md, be/BACKEND_MASTER.md, fe/FRONTEND_MASTER.md
AGENTS.md
EXECUTION_ROADMAP.md

# IDE & Editor Files
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo
*.swn
*~
.#*

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

